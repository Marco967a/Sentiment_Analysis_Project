# MongoDB container (usate da docker-compose) - scegli password robuste
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change_me_too

# MongoDB Configuration (uso locale fuori da Docker: stessa password di MONGO_ROOT_PASSWORD)
MONGODB_URI=mongodb://root:change_me@localhost:27017/
MONGODB_DB_NAME=sentiment_db

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here

# NLP Settings
# Modello per l'inglese e modello multilingue per le altre lingue (routing sulla lingua rilevata)
TRANSFORMERS_MODEL_EN=cardiffnlp/twitter-roberta-base-sentiment-latest
TRANSFORMERS_MODEL_MULTI=cardiffnlp/twitter-xlm-roberta-base-sentiment

